# Configuration for Grist MCP Server
# Make a copy of this file as .env and fill in your actual API key

# Grist API Key (required)
# Get this from your Grist account settings
GRIST_API_KEY=your_api_key_here

# Grist API Host (optional, defaults to docs.getgrist.com/api)
# Use this to connect to a custom Grist instance
GRIST_API_HOST=https://docs.getgrist.com/api

# Timezone (optional, defaults to Europe/London UTC+0)
# Set your timezone using IANA timezone name for datetime conversion
# Supported timezones:
#   - Australia/Sydney (UTC+11)
#   - Asia/Tokyo (UTC+9)
#   - Asia/Shanghai (UTC+8)
#   - Asia/Kuala_Lumpur (UTC+8)
#   - Asia/Kolkata (UTC+5.5)
#   - Asia/Dubai (UTC+4)
#   - Europe/Paris (UTC+1)
#   - Europe/London (UTC+0)
#   - America/New_York (UTC-5)
#   - America/Los_Angeles (UTC-8)
TIMEZONE=Asia/Kuala_Lumpur

# Log level (optional, defaults to INFO)
# Available options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
